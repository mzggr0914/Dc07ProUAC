<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Dc07ProUAC.Presentation.ViewModels"
    xmlns:fluent="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
    x:DataType="vm:MainWindowViewModel"
    x:Class="Dc07ProUAC.Presentation.Views.MainWindow"
    Width="800"
    SizeToContent="Height"
    CanResize="False"
    Title="iBasso DC07Pro UAC Control">

    <Window.DataContext>
        <vm:MainWindowViewModel/>
    </Window.DataContext>

    <Window.Styles>
        <Style Selector="Border.card">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}"/>
        </Style>

        <Style Selector="Border.pill">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}"/>
        </Style>

        <Style Selector="TextBlock.h2">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="TextBlock.caption">
            <Setter Property="Opacity" Value="0.72"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style Selector="Button.step">
            <Setter Property="MinWidth" Value="48"/>
        </Style>

        <Style Selector="Button.footer">
            <Setter Property="MinWidth" Value="86"/>
        </Style>

        <Style Selector="Button.accent">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto">
        <Border Padding="28,12"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <fluent:FluentIcon Icon="Headphones" FontSize="20" Width="22"/>
                    <StackPanel Spacing="1">
                        <TextBlock Text="iBasso DC07Pro" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="UAC Controller" Opacity="0.7" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Classes="pill" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <fluent:FluentIcon Icon="{Binding ConnectionIcon}" FontSize="14"/>
                            <TextBlock Text="{Binding ConnectionText}" FontSize="11" Opacity="0.85"/>
                        </StackPanel>
                    </Border>
                    <ToggleSwitch IsChecked="{Binding IsAutoApply}" Content="Auto Apply"/>
                    <ToggleSwitch IsChecked="{Binding IsDarkMode, Mode=TwoWay}" Content="Dark Mode"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Margin="16,14,16,16"
              ColumnDefinitions="*,*"
              ColumnSpacing="12"
              RowDefinitions="Auto,Auto,Auto"
              RowSpacing="12">

            <Border Classes="card">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                        <fluent:FluentIcon Icon="Speaker2" FontSize="18" Width="22"/>
                        <TextBlock Grid.Column="1" Classes="h2" Text="Volume"/>
                        <Border Grid.Column="2" Classes="pill">
                            <TextBlock Text="{Binding VolumeDisplay}" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                        <Button Classes="step" Content="&#x2212;1" Command="{Binding VolumeDownCommand}"/>
                        <Slider Grid.Column="1"
                                Minimum="0" Maximum="100"
                                Value="{Binding Volume, Mode=TwoWay}"
                                LargeChange="5" SmallChange="1"/>
                        <Button Grid.Column="2" Classes="step" Content="+1" Command="{Binding VolumeUpCommand}"/>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="0" Grid.Column="1" Classes="card">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                        <fluent:FluentIcon Icon="Settings" FontSize="18" Width="22"/>
                        <TextBlock Grid.Column="1" Classes="h2" Text="Balance"/>
                        <Border Grid.Column="2" Classes="pill">
                            <TextBlock Text="{Binding BalanceDisplay}" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                        <TextBlock Text="L" Opacity="0.75" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1"
                                Minimum="-10" Maximum="10"
                                Value="{Binding Balance, Mode=TwoWay}"
                                LargeChange="2" SmallChange="1"/>
                        <TextBlock Grid.Column="2" Text="R" Opacity="0.75" VerticalAlignment="Center"/>
                        <Button Grid.Column="3" Content="Center" Command="{Binding BalanceCenterCommand}" MinWidth="76"/>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="0" Grid.Row="1" Classes="card">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalAlignment="Center">
                        <fluent:FluentIcon Icon="Settings" FontSize="18" Width="22"/>
                        <TextBlock Grid.Column="1" Classes="h2" Text="Analog"/>
                    </Grid>

                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalAlignment="Center">
                        <TextBlock Classes="caption" Text="Gain" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <RadioButton Content="Low" GroupName="Gain" IsChecked="{Binding IsGainLow, Mode=TwoWay}"/>
                            <RadioButton Content="Mid" GroupName="Gain" IsChecked="{Binding IsGainMid, Mode=TwoWay}"/>
                            <RadioButton Content="High" GroupName="Gain" IsChecked="{Binding IsGainHigh, Mode=TwoWay}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="1" Grid.Column="1" Classes="card">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalAlignment="Center">
                        <fluent:FluentIcon Icon="MusicNote2" FontSize="18" Width="22"/>
                        <TextBlock Grid.Column="1" Classes="h2" Text="Digital"/>
                    </Grid>

                    <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10" VerticalAlignment="Center">
                        <ToggleSwitch Content="SPDIF" IsChecked="{Binding SpdifEnabled}"/>
                        <ToggleSwitch Grid.Column="1" Content="HP FILTER" IsChecked="{Binding HpFilterEnabled}"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Classes="caption" Text="Filter" VerticalAlignment="Center"/>
                            <ComboBox Width="96" SelectedItem="{Binding SelectedFilter}" ItemsSource="{Binding Filters}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{Binding}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2" Classes="card" Padding="10">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FooterStatus}"
                               Opacity="0.78"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Classes="footer" Content="Select Device" Command="{Binding SelectDeviceCommand}"/>
                        <Button Classes="footer" Content="Refresh" Command="{Binding RefreshCommand}"/>
                        <Button Classes="footer accent" Content="Apply" Command="{Binding ApplyCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
