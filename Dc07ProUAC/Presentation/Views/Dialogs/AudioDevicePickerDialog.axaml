<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Dc07ProUAC.Presentation.Views.Dialogs"
        x:Class="Dc07ProUAC.Presentation.Views.Dialogs.AudioDevicePickerDialog"
        x:DataType="local:AudioDevicePickerDialog+ViewModel"
        Width="720" Height="620"
        Title="Select HID Device"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16">

        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
            <TextBlock FontSize="18" FontWeight="SemiBold"
                       Text="Select a device" />

            <Button Grid.Row="0" Grid.Column="1" MinWidth="96"
                    Content="Refresh"
                    Command="{Binding RefreshCommand}" />

            <TextBox Grid.Row="1" Grid.ColumnSpan="2" Grid.Column="0"
                     PlaceholderText="Ranking keyword (default: Dc07Pro). Examples: DC07 Pro, DC07, iBasso"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <Border Grid.Row="1" CornerRadius="12" BorderThickness="1" Padding="12">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="8">
                <ProgressBar Width="140" Height="8" IsIndeterminate="True" IsVisible="{Binding IsLoading}" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding StatusText}" Opacity="0.8" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Grid.Column="0"
                           Text="{Binding ErrorText}"
                           Foreground="Tomato"
                           IsVisible="{Binding HasError}"
                           TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" CornerRadius="12" BorderThickness="1" Padding="10">
            <ListBox ItemsSource="{Binding Devices}"
                     SelectedItem="{Binding Selected}"
                     HorizontalAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="local:AudioDevicePickerDialog+DeviceRow">
                        <Grid ColumnDefinitions="*,Auto" Margin="8" ColumnSpacing="16">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Subtitle}" Opacity="0.75" FontSize="12" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding VidPidText}"
                                       Opacity="0.8"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button MinWidth="96" Content="Cancel"
                    Command="{Binding CancelCommand}" />
            <Button MinWidth="96" Content="Select"
                    IsDefault="True"
                    IsEnabled="{Binding CanAccept}"
                    Command="{Binding AcceptCommand}" />
        </StackPanel>

    </Grid>
</Window>
